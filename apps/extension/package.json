{
  "name": "omnidl-extension",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "description": "Omni Download browser extension for Chrome, Edge and Firefox",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox --mv3",
    "lint": "wxt prepare && tsc --noEmit",
    "eslint": "eslint .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "omni-ui": "github:VoidDel/omni-ui#main",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
