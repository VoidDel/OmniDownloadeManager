{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Download",
  "mainBinaryName": "omnidl-desktop",
  "version": "0.1.0",
  "identifier": "app.omnidownload.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "cargo build -p omnidl-nm-host && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Omni Download Contributors",
    "copyright": "Copyright (c) 2026 Omni Download Contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Download manager for HTTP, FTP, BitTorrent and magnet links",
    "longDescription": "Omni Download is a cross-platform download manager with multi-connection, resumable HTTP and FTP downloads, BitTorrent and magnet links, and extensions for Chrome, Edge and Firefox.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
