{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Download",
  "mainBinaryName": "omnidl-desktop",
  "version": "0.1.0",
  "identifier": "app.omnidownload.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "cargo build -p omnidl-nm-host && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Omni Download Contributors",
    "copyright": "Copyright (c) 2026 Omni Download Contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Download manager for HTTP, FTP, BitTorrent and magnet links",
    "longDescription": "Omni Download is a cross-platform download manager with multi-connection, resumable HTTP and FTP downloads, BitTorrent and magnet links, and extensions for Chrome, Edge and Firefox.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3Q0M5MkY0QjU3Q0Q5ODYKUldTRzJYeTE5SkxNRjRueC9CcG5YYndhVFFlc0llY0hiSGJEOG9NTWJ0QmRKYXpDeDZHWXBqUFEK",
      "endpoints": [
        "https://github.com/VoidDel/OmniDownloadeManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
