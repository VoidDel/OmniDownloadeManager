{
  "name": "omnidl-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter omnidl-desktop tauri dev",
    "build": "pnpm --filter omnidl-desktop tauri build",
    "bundle": "node scripts/bundle.mjs",
    "lint": "pnpm -r lint",
    "eslint": "pnpm -r eslint",
    "test": "pnpm -r test",
    "sync:omni-ui": "node scripts/sync-omni-ui.mjs",
    "check:locales": "node scripts/check-locales.mjs && node scripts/check-ext-locales.mjs",
    "icons": "pnpm --filter omnidl-desktop tauri icon ../../icons/app-icon.svg -o src-tauri/icons && node scripts/windows-ico.mjs",
    "ext:build": "pnpm --filter omnidl-extension build",
    "ext:zip": "node scripts/ext-zip.mjs",
    "ext:e2e": "pnpm --filter omnidl-extension e2e",
    "e2e": "pnpm --filter omnidl-desktop e2e"
  }
}
